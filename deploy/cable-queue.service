[Unit]
Description=Cable WhatsApp bounded queue tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cable-queue
WorkingDirectory=/opt/cable-queue
EnvironmentFile=/etc/cable-queue.env
ExecStart=/usr/bin/node --experimental-strip-types /opt/cable-queue/queue-tick.ts
TimeoutStartSec=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

